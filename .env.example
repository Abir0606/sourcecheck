# ---------------------------------------------------------------------------
# SourceCheck — safe example configuration.
# Copy to `.env` and edit. NOTHING here is a real secret. No Azure values are
# required to run locally. See docs/privacy/decisions-needed.md.
# ---------------------------------------------------------------------------

# --- Core ---
DJANGO_ENV=local
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# CORS origins allowed to call the API with credentials (the SPA origin).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
POSTGRES_DB=sourcecheck
POSTGRES_USER=sourcecheck
POSTGRES_PASSWORD=sourcecheck
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Host port 5433 matches docker-compose (containers use db:5432 internally).
DATABASE_URL=postgres://sourcecheck:sourcecheck@localhost:5433/sourcecheck
# Embedding dimension must match the configured analyzer/embedding adapter.
EMBEDDING_DIM=384

# --- Queue / broker ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage adapter: local | azure ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
# Azure Blob (only used when STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=documents
# Auth to storage: managed_identity | connection_string | account_key
AZURE_STORAGE_AUTH=managed_identity

# --- Vector store: pgvector | pgvector (local) ---
VECTOR_STORE=pgvector

# --- OCR adapter: none | tesseract ---
OCR_PROVIDER=none
TESSERACT_CMD=tesseract

# --- Analyzer adapter: rules | openai_compatible | azure_openai ---
# `rules` is fully offline and deterministic — the default. It never calls the internet.
ANALYZER_BACKEND=rules
# Only used when ANALYZER_BACKEND is openai_compatible or azure_openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Secrets provider: env | key_vault ---
SECRET_PROVIDER=env
AZURE_KEY_VAULT_URL=

# --- Privacy defaults (configurable; see decisions-needed.md) ---
DATA_REGION=local
DEFAULT_RETENTION_DAYS=0
LOG_DOCUMENT_TEXT=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
